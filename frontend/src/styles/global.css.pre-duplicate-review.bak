@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  font-family: "DM Sans", "Noto Sans Ethiopic", sans-serif;
  color: #20283d;
  background: #f6f8fc;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  font-optical-sizing: auto;
  font-weight: 400;
}

* { box-sizing: border-box; }
body { margin: 0; min-width: 320px; min-height: 100vh; }
button, input, select { font: inherit; }
button { cursor: pointer; }
button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 3px solid #abc8ff;
  outline-offset: 2px;
}

.app-shell { min-height: 100vh; }
.sidebar {
  width: 245px; position: fixed; inset: 0 auto 0 0;
  background: #fff; border-right: 1px solid #e9edf5;
  display: flex; flex-direction: column; padding: 28px 17px 18px; z-index: 5;
}
.brand { display: flex; align-items: center; gap: 11px; padding: 0 10px 34px; }
.brand-mark {
  display: grid; place-items: center; width: 43px; height: 43px;
  border-radius: 13px; background: #315de8; color: white; font: 800 24px Manrope, sans-serif;
  box-shadow: 0 7px 15px #315de82b;
}
.brand strong { display: block; font: 800 20px Manrope, sans-serif; letter-spacing: -.6px; }
.brand span { display: block; color: #8992a7; font-size: 11px; margin-top: 2px; }
.nav-heading { font-size: 10px; font-weight: 700; letter-spacing: 1.5px; color: #a2a9b9; padding: 0 12px 11px; }
.navigation { display: grid; gap: 6px; }
.nav-item {
  border: 0; background: transparent; color: #727d92; width: 100%;
  border-radius: 10px; display: flex; align-items: center; gap: 12px;
  padding: 12px 13px; text-align: left; font-size: 13px; font-weight: 600; position: relative;
  transition: background .15s, color .15s;
}
.nav-item:hover { background: #f5f7ff; color: #315de8; }
.nav-item.active { background: #edf2ff; color: #315de8; }
.nav-icon { font-size: 20px; line-height: 1; width: 22px; text-align: center; }
.active-dot { margin-left: auto; width: 5px; height: 5px; border-radius: 50%; background: #315de8; }
.sidebar-bottom {
  margin-top: auto; background: #f5f7fd; border: 1px solid #edf0f7; border-radius: 13px;
  padding: 16px 13px;
}
.small-book { color: #315de8; font-size: 22px; margin-bottom: 7px; }
.sidebar-bottom strong { display: block; font-size: 12px; }
.sidebar-bottom p { margin: 7px 0 0; line-height: 1.6; color: #8790a4; font-size: 11px; }

.main-area { margin-left: 245px; min-height: 100vh; }
.topbar {
  background: #fff; min-height: 100px; border-bottom: 1px solid #e9edf5;
  padding: 22px 38px; display: flex; justify-content: space-between; align-items: center; gap: 18px;
}
.breadcrumb { color: #9aa2b4; font-size: 11px; margin-bottom: 7px; }
.breadcrumb span { color: #59647a; }
.topbar h1 { margin: 0; font: 800 23px Manrope, sans-serif; letter-spacing: -.7px; }
.topbar-status {
  display: inline-flex; align-items: center; gap: 8px; border: 1px solid #e7ebf3;
  border-radius: 30px; background: #fff; padding: 9px 12px; color: #667187; font-size: 11px; white-space: nowrap;
}
.status-dot { width: 7px; height: 7px; background: #e0a13c; border-radius: 50%; }
.status-dot.online { background: #2cba84; box-shadow: 0 0 0 3px #e3f8ef; }

.page-content { max-width: 1440px; margin: 0 auto; padding: 29px 38px 22px; }
.welcome-panel {
  min-height: 224px; border-radius: 16px; overflow: hidden; position: relative;
  background: linear-gradient(110deg, #eaf0ff 0%, #f2f4ff 53%, #e2eaff 100%);
  border: 1px solid #e2e9ff; padding: 32px 35px; display: flex; align-items: center; justify-content: space-between;
}
.eyebrow { font-size: 10px; font-weight: 800; letter-spacing: 1.7px; color: #4163d5; margin-bottom: 11px; }
.welcome-panel h2 { margin: 0; font: 800 clamp(23px, 2.4vw, 31px) Manrope, sans-serif; letter-spacing: -1px; }
.welcome-panel p { font-size: 13px; color: #6e7a99; margin: 11px 0 20px; }
.primary-button {
  border: 0; color: white; background: #315de8; border-radius: 8px; padding: 11px 15px;
  font-size: 12px; font-weight: 700; box-shadow: 0 5px 12px #315de826; transition: background .15s, transform .15s;
}
.primary-button:hover { background: #244bcc; transform: translateY(-1px); }
.primary-button span { margin-left: 10px; font-size: 15px; }
.welcome-illustration { width: 195px; height: 175px; position: relative; margin-right: 30px; flex-shrink: 0; }
.illustration-circle { position: absolute; width: 155px; height: 155px; border-radius: 50%; right: -12px; top: 8px; background: #d5e0ff; }
.book-stack { position: absolute; top: 31px; left: 16px; z-index: 2; width: 152px; height: 119px; transform: rotate(-6deg); }
.book { display: block; position: absolute; height: 25px; border-radius: 4px 8px 8px 4px; box-shadow: 0 5px 8px #3b4f8a1c; }
.book::after { content: ""; position: absolute; width: 4px; left: 12px; top: 4px; bottom: 4px; background: #ffffff73; border-radius: 3px; }
.book-one { width: 137px; left: 4px; top: 0; background: #f2aa6d; transform: rotate(5deg); }
.book-two { width: 150px; left: 0; top: 31px; background: #596ed6; transform: rotate(-2deg); }
.book-three { width: 129px; left: 13px; top: 61px; background: #6fbcaa; transform: rotate(3deg); }
.book-four { width: 144px; left: 0; top: 91px; background: #e48a9b; transform: rotate(-2deg); }

.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin: 29px 0 15px; }
.section-heading h2, .panel-heading h2 { margin: 0; font: 800 16px Manrope, sans-serif; letter-spacing: -.35px; }
.section-heading p, .panel-heading p { color: #959db0; font-size: 11px; margin: 6px 0 0; }
.stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.stat-card {
  min-width: 0; border-radius: 12px; border: 1px solid #e9edf5; background: white;
  padding: 17px; text-align: left; display: flex; flex-direction: column; align-items: flex-start;
  box-shadow: 0 3px 8px #253b6505;
}
button.stat-card { transition: border-color .15s, transform .15s; }
button.stat-card:hover { border-color: #b9c8ff; transform: translateY(-2px); }
.stat-icon { display: grid; place-items: center; width: 35px; height: 35px; border-radius: 10px; font-size: 19px; margin-bottom: 14px; }
.stat-icon.blue { background: #e9efff; color: #4265e4; }
.stat-icon.purple { background: #f0eaff; color: #8b63d9; }
.stat-icon.green { background: #e2f8ee; color: #2caa78; }
.stat-icon.orange { background: #fff0df; color: #dc9344; }
.stat-label { font-size: 11px; color: #7e899e; }
.stat-card > strong { font: 800 26px Manrope, sans-serif; padding: 4px 0 10px; }
.stat-foot { font-size: 10px; color: #a0a7b7; line-height: 1.45; }
.stat-foot > span { color: #315de8; margin-left: 4px; }

.content-panel { background: #fff; border: 1px solid #e9edf5; border-radius: 13px; margin-top: 20px; overflow: hidden; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 20px 22px; border-bottom: 1px solid #eef1f6; }
.text-button { color: #315de8; border: 0; background: transparent; font-size: 11px; font-weight: 700; padding: 8px; }
.text-button:hover { color: #173eae; }
.book-list { padding: 0 22px; }
.book-row { min-height: 61px; display: flex; align-items: center; gap: 13px; border-bottom: 1px solid #f0f2f7; }
.book-row:last-child { border-bottom: 0; }
.mini-book { display: grid; place-items: center; width: 34px; height: 38px; background: #edf2ff; color: #4767db; border-radius: 6px; font-size: 19px; }
.book-row-info { display: grid; gap: 5px; min-width: 0; }
.book-row-info strong { font-size: 12px; overflow-wrap: anywhere; }
.book-row-info span { font-size: 10px; color: #8c96aa; }
.subtle-label { color: #a1a8b7; font-size: 10px; }
.book-row .subtle-label { margin-left: auto; }
.empty-state { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 38px 20px; }
.empty-icon { display: grid; place-items: center; width: 47px; height: 47px; border-radius: 14px; background: #eef2ff; color: #4164e2; font-size: 23px; margin-bottom: 13px; }
.empty-state strong { font: 700 13px Manrope, sans-serif; }
.empty-state p { color: #939caf; font-size: 11px; margin: 8px 0 15px; line-height: 1.6; }

.resource-heading { margin-top: 4px; margin-bottom: 20px; }
.filter-panel { padding: 18px 20px; display: flex; align-items: center; flex-wrap: wrap; gap: 13px; }
.filter-panel label { font-size: 12px; font-weight: 700; }
.filter-panel select { min-width: 220px; max-width: 100%; }
.helper-text { color: #969fb1; font-size: 11px; margin: 0; line-height: 1.6; }
.form-panel { padding: 22px; }
.form-panel h3 { font: 800 15px Manrope, sans-serif; margin: 0 0 16px; }
.form-panel > .helper-text { margin: -8px 0 18px; }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 15px; margin-bottom: 18px; }
.form-grid label { display: grid; gap: 7px; color: #657086; font-size: 11px; font-weight: 700; }
input, select { width: 100%; min-width: 0; border: 1px solid #e2e7f0; background: #fff; border-radius: 7px; padding: 11px 12px; font-size: 12px; color: #263149; }
input::placeholder { color: #b0b6c4; }
input:focus, select:focus { border-color: #8ca5ff; outline: 3px solid #edf1ff; }
.table-panel { margin-top: 20px; }
.table-topline { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #eef1f6; padding: 16px 21px; }
.table-topline strong { font-size: 11px; }
.table-scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; text-align: left; }
th { background: #fafbfe; color: #8b94a8; font-size: 10px; font-weight: 700; letter-spacing: .2px; padding: 13px 17px; white-space: nowrap; }
td { padding: 14px 17px; border-top: 1px solid #f0f2f7; color: #546078; font-size: 11px; white-space: nowrap; }
tr:hover td { background: #fbfcff; }
.record-status { display: inline-block; padding: 5px 8px; border-radius: 20px; background: #f0f2f7; color: #687388; font-size: 10px; }
.record-status.approved, .record-status.active, .record-status.available, .record-status.returned { background: #e6f8ef; color: #219568; }
.record-status.pending, .record-status.overdue { background: #fff2df; color: #bd7b22; }
.notice { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 15px; margin-bottom: 13px; border-radius: 8px; font-size: 12px; line-height: 1.5; }
.notice button { background: transparent; border: 0; font-size: 18px; color: inherit; }
.error-notice { color: #a53c42; background: #fff0f0; border: 1px solid #f6d5d6; }
.success-notice { color: #1c815d; background: #ebfaf3; border: 1px solid #ccefe0; }
.page-footer { display: flex; justify-content: space-between; gap: 12px; color: #abb2c1; font-size: 10px; padding: 28px 0 8px; }

@media (max-width: 1100px) {
  .sidebar { width: 205px; }
  .main-area { margin-left: 205px; }
  .page-content { padding: 24px; }
  .topbar { padding: 20px 24px; }
  .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .welcome-illustration { margin-right: 0; transform: scale(.85); transform-origin: right center; }
}
@media (max-width: 700px) {
  .sidebar { position: static; width: 100%; padding: 14px; border-right: 0; border-bottom: 1px solid #e9edf5; }
  .brand { padding: 0 5px 14px; }
  .nav-heading, .sidebar-bottom { display: none; }
  .navigation { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 4px; }
  .nav-item { justify-content: center; padding: 10px 4px; font-size: 10px; gap: 5px; }
  .nav-icon { font-size: 16px; width: auto; }
  .active-dot { display: none; }
  .main-area { margin-left: 0; }
  .topbar { min-height: auto; padding: 19px 16px; align-items: flex-start; }
  .topbar h1 { font-size: 20px; }
  .topbar-status { font-size: 10px; padding: 8px; }
  .page-content { padding: 18px 14px; }
  .welcome-panel { padding: 24px 19px; min-height: 220px; }
  .welcome-panel p { max-width: 290px; line-height: 1.6; }
  .welcome-illustration { position: absolute; right: -20px; bottom: -33px; opacity: .24; transform: scale(.8); }
  .stat-grid { gap: 9px; }
  .stat-card { padding: 13px; }
  .stat-card > strong { font-size: 23px; }
  .stat-foot { font-size: 9px; }
  .section-heading { align-items: flex-start; }
  .form-grid { grid-template-columns: 1fr; }
  .filter-panel { align-items: flex-start; flex-direction: column; }
  .filter-panel select { min-width: 0; }
  .page-footer { flex-direction: column; line-height: 1.5; }
}


/* Institution review actions */
.row-actions { display: flex; align-items: center; gap: 7px; }
.approve-button, .reject-button {
  border: 0;
  border-radius: 6px;
  padding: 7px 10px;
  font-size: 10px;
  font-weight: 700;
}
.approve-button { background: #e3f7ed; color: #18845a; }
.approve-button:hover { background: #c9efdc; }
.reject-button { background: #fff0f0; color: #b94149; }
.reject-button:hover { background: #ffdddd; }


/* Return button in loan records */
.return-button {
  border: 0;
  border-radius: 6px;
  padding: 7px 10px;
  font-size: 10px;
  font-weight: 700;
  background: #eef2ff;
  color: #315de8;
}
.return-button:hover { background: #dce5ff; }
