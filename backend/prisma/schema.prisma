generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum InstitutionStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum UserRole {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  LIBRARIAN
  TEACHER
  STUDENT
  PARENT
  MEMBER
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CopyStatus {
  AVAILABLE
  LOANED
  RESERVED
  LOST
  DAMAGED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  LOST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Institution {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  email       String?
  phone       String?
  address     String?
  status      InstitutionStatus  @default(PENDING)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships InstitutionUser[]
  copies      BookCopy[]
  members     Member[]
  loans       Loan[]
  settings    InstitutionSettings?
}

model User {
  id          String             @id @default(cuid())
  fullName    String
  email       String             @unique
  passwordHash String
  isSuperAdmin Boolean           @default(false)
  status      RecordStatus       @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships InstitutionUser[]
}

model InstitutionUser {
  id            String      @id @default(cuid())
  institutionId String
  userId        String
  role          UserRole
  createdAt     DateTime    @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([userId])
}

model Book {
  id          String   @id @default(cuid())
  isbn        String?
  title       String
  author      String
  publisher   String?
  edition     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  copiesAsBook BookCopy[]
  duplicateCandidates DuplicateReview[] @relation("CandidateBook")
  duplicateMatches    DuplicateReview[] @relation("MatchedBook")

  @@index([title])
  @@index([author])
  @@index([isbn])
}

model BookCopy {
  id            String     @id @default(cuid())
  institutionId String
  bookId        String
  barcode       String
  status        CopyStatus @default(AVAILABLE)
  shelfLocation String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Restrict)
  loans       Loan[]

  @@unique([institutionId, barcode])
  @@index([institutionId, status])
  @@index([bookId])
}

model Member {
  id               String       @id @default(cuid())
  institutionId    String
  membershipNumber String
  fullName         String
  email            String?
  phone            String?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  loans       Loan[]

  @@unique([institutionId, membershipNumber])
  @@index([institutionId, fullName])
}

model Loan {
  id            String     @id @default(cuid())
  institutionId String
  memberId      String
  bookCopyId    String
  borrowedAt    DateTime   @default(now())
  dueAt         DateTime
  returnedAt    DateTime?
  status        LoanStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  member      Member      @relation(fields: [memberId], references: [id], onDelete: Restrict)
  bookCopy    BookCopy    @relation(fields: [bookCopyId], references: [id], onDelete: Restrict)

  @@index([institutionId, status])
  @@index([memberId])
  @@index([bookCopyId])
}

model InstitutionSettings {
  id            String   @id @default(cuid())
  institutionId String   @unique
  loanDays      Int      @default(14)
  maxLoans      Int      @default(5)
  finePerDay    Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model DuplicateReview {
  id              String       @id @default(cuid())
  candidateBookId String
  matchedBookId   String
  reason          String?
  status          ReviewStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  reviewedAt      DateTime?

  candidateBook Book @relation("CandidateBook", fields: [candidateBookId], references: [id], onDelete: Cascade)
  matchedBook   Book @relation("MatchedBook", fields: [matchedBookId], references: [id], onDelete: Cascade)

  @@index([status])
}
